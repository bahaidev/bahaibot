{
  "name": "bahaibot",
  "version": "0.4.2",
  "description": "A bot made for Bahá'í discourses",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js"
    },
    "./bot": {
      "types": "./dist/bot.d.ts",
      "import": "./src/bot.js"
    },
    "./discordBot": {
      "types": "./dist/discordBot.d.ts",
      "import": "./src/discordBot.js"
    },
    "./getDialogflowAdapter": {
      "types": "./dist/getDialogflowAdapter.d.ts",
      "import": "./src/getDialogflowAdapter.js"
    },
    "./integratedClientServerBot": {
      "types": "./dist/integratedClientServerBot.d.ts",
      "import": "./src/integratedClientServerBot.js"
    }
  },
  "bin": {
    "bahaibot": "./src/binary.js"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@formatjs/intl-durationformat": "^0.10.18",
    "@google-cloud/dialogflow": "^7.9.0",
    "@snazzah/davey": "^0.1.12",
    "badidate": "^3.1.1",
    "bahai-date-api": "github:dragfyre/bahai-date-api",
    "discord-tts": "^1.2.2",
    "discord.js": "^14.27.0",
    "discord.js-rate-limiter": "^1.3.2",
    "file-fetch": "^2.0.1",
    "intl-dom": "^0.20.0",
    "set-safer-interval": "^0.4.0",
    "string-strip-html": "^13.5.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/chai": "^5.2.3",
    "@types/file-fetch": "^1.6.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/sinon": "^22.0.0",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.0",
    "eslint-config-ash-nazg": "42.0.1",
    "eslint-plugin-jsonc": "^3.4.1",
    "husky": "^9.1.7",
    "knex": "^3.3.0",
    "lint-staged": "^17.3.0",
    "mocha": "^11.8.0",
    "mysql2": "^3.23.2",
    "nodemon": "^3.1.14",
    "rollup": "^4.62.4",
    "sinon": "^22.1.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "browserslist": [
    "last 2 chrome versions"
  ],
  "scripts": {
    "attw": "attw --profile node16 --pack",
    "prepublishOnly": "pnpm i && pnpm rollup && npm run attw",
    "tsc": "tsc",
    "tsc-prod": "tsc -p tsconfig-prod.json",
    "rollup": "rm -Rf dist && rollup -c && npm run tsc-prod",
    "typedoc": "typedoc",
    "lint": "eslint --ext=js,md,html .",
    "lint-arg-fix": "eslint --fix --ext=js,md,html",
    "lint-json-arg-fix": "eslint --config=eslint.config.json.js --fix --ext=json",
    "lint-json": "eslint --config=eslint.config.json.js --ext=json library",
    "start-dev": "nodemon src/index.js",
    "start": "node src/index.js --checkins",
    "start-prod": "node src/index.js --checkins --production",
    "mocha": "mocha --exit --timeout 9000",
    "dolt": "dolt sql-server --port 3307",
    "dolt-start": "node dolt-scripts/hidden-words.js",
    "dolt-titles": "node dolt-scripts/hidden-words-titles.js",
    "dolt-authors": "node dolt-scripts/authors.js",
    "prepare": "husky",
    "test": "rm -Rf ./node_modules/.cache && c8 --check-coverage --statements 100 --lines 100 --functions 100 --branches 100 npm run mocha test/*.js"
  },
  "lint-staged": {
    "library/*.json": "npm run lint-json-arg-fix --",
    "*.{js,md,html}": "npm run lint-arg-fix --"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahaidev/bahaibot.git"
  },
  "keywords": [
    "discord",
    "bot",
    "Bahai"
  ],
  "author": "Bahaidev",
  "contributors": [
    "Adib Behjat",
    "dragfyre",
    "Brett Zamir"
  ],
  "license": "GPL-2.0-only",
  "bugs": "https://github.com/bahaidev/bahaibot/issues",
  "homepage": "https://github.com/bahaidev/bahaibot#readme",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
